/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  //
  // Dialog-generated settings
  //
  Project.AddPathSubstitute ("E:/stm32cubemx exe/26diansai", "$(ProjectDir)");
  Project.AddPathSubstitute ("e:/stm32cubemx exe/26diansai", "$(ProjectDir)");
  Project.SetDevice ("STM32F407VG");
  Project.SetHostIF ("USB", "");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("4 MHz");
  Project.AddSvdFile ("$(InstallDir)/Config/CPU/Cortex-M4F.svd");
  //
  // User settings
  //
  File.Open ("$(ProjectDir)/build/Debug/26diansai.elf");
  Project.SetOSPlugin ("FreeRTOSPlugin_Cortex-M");
  Watch.Add ("g_motor_debug_mailbox.unlock_key");
  Watch.Add ("g_motor_debug_mailbox.operation");
  Watch.Add ("g_motor_debug_mailbox.request_sequence");
  Watch.Add ("g_motor_debug_mailbox.completed_sequence");
  Watch.Add ("g_motor_debug_mailbox.result");
  Watch.Add ("g_motor_debug_mailbox.position_valid");
  Watch.Add ("g_motor_debug_mailbox.position_degrees");
  Watch.Add ("g_motor_debug_mailbox.position_error_degrees");
  Watch.Add ("g_motor_debug_mailbox.sample_count");
  Watch.Add ("g_motor_debug_mailbox.zeroed");
  Watch.Add ("g_motor_debug_mailbox.motion_active");
  Watch.Add ("g_motor_debug_mailbox.config_valid");
  Watch.Add ("g_motor_debug_mailbox.config_firmware_type");
  Watch.Add ("g_motor_debug_mailbox.config_total_bytes");
  Watch.Add ("g_motor_debug_mailbox.config_parameter_count");
  Watch.Add ("g_motor_debug_mailbox.config_motor_type");
  Watch.Add ("g_motor_debug_mailbox.config_microstep");
  Watch.Add ("g_motor_debug_mailbox.config_pulses_per_revolution");
  Watch.Add ("g_motor_debug_mailbox.config_address");
  Watch.Add ("g_motor_debug_mailbox.config_serial_baud_rate");
  Watch.Add ("g_motor_debug_mailbox.config_checksum_mode");
  Watch.Add ("g_motor_debug_mailbox.config_response_mode");
  Watch.Add ("g_motor_debug_mailbox.config_position_window_tenths_degree");
  Watch.Add ("g_motor_debug_mailbox.control_tuning_valid");
  Watch.Add ("g_motor_debug_mailbox.control_angle_offset_degrees");
  Watch.Add ("g_motor_debug_mailbox.control_position_gain_degrees_per_cm");
  Watch.Add ("g_motor_debug_mailbox.control_velocity_gain_degrees_per_pixel_s");
  Watch.Add ("g_motor_debug_mailbox.control_angle_limit_degrees");
  Watch.Add ("g_motor_debug_mailbox.control_minimum_command_delta_degrees");
  Watch.Add ("g_motor_debug_mailbox.last_update_ms");
  Watch.Add ("g_motor_debug_mailbox.task_selected");
  Watch.Add ("g_motor_debug_mailbox.task_run_state");
  Watch.Add ("g_motor_debug_mailbox.task_fault");
  Watch.Add ("g_motor_debug_mailbox.task_phase");
  Watch.Add ("g_motor_debug_mailbox.task_motor_enabled");
  Watch.Add ("g_motor_debug_mailbox.task_vision_valid");
  Watch.Add ("g_motor_debug_mailbox.task_elapsed_ms");
  Watch.Add ("g_motor_debug_mailbox.task_vision_age_ms");
  Watch.Add ("g_motor_debug_mailbox.task_position_cm");
  Watch.Add ("g_motor_debug_mailbox.task_confidence");
  Watch.Add ("g_motor_debug_mailbox.task_reference_cm");
  Watch.Add ("g_motor_debug_mailbox.task_position_sample_count");
  Watch.Add ("g_motor_debug_mailbox.task_min_position_cm");
  Watch.Add ("g_motor_debug_mailbox.task_max_position_cm");
  Watch.Add ("g_motor_debug_mailbox.task_best_abs_error_cm");
  Watch.Add ("g_motor_debug_mailbox.task_best_position_cm");
  Watch.Add ("g_motor_debug_mailbox.task_in_tolerance_sample_count");
  Watch.Add ("g_motor_debug_mailbox.task_target_settled");
  Watch.Add ("g_motor_debug_mailbox.task_settled_position_cm");
  Watch.Add ("g_motor_debug_mailbox.task_vision_reject_count");
  Watch.Add ("g_motor_debug_mailbox.task_vision_reject_reason");
  Watch.Add ("g_motor_debug_mailbox.task_rejected_measurement_valid");
  Watch.Add ("g_motor_debug_mailbox.task_rejected_position_cm");
  Watch.Add ("g_motor_debug_mailbox.task_rejected_confidence");
  Watch.Add ("g_motor_debug_mailbox.task_rejected_duration_ms");
  Watch.Add ("g_motor_debug_mailbox.task_target_angle_degrees");
  Watch.Add ("g_motor_debug_mailbox.task_motor_position_valid");
  Watch.Add ("g_motor_debug_mailbox.task_motor_position_degrees");
  Watch.Add ("g_motor_debug_mailbox.motor_position_read_result");
  Watch.Add ("g_motor_debug_mailbox.task_motor_error");
  Watch.Add ("g_motor_debug_mailbox.task_start_stage");
  Watch.Add ("g_motor_debug_mailbox.task_start_result");
  Watch.Add ("g_motor_debug_mailbox.control_command_active");
  Watch.Add ("g_motor_debug_mailbox.control_command_count");
  Watch.Add ("g_motor_debug_mailbox.control_last_command_angle_degrees");
  Watch.Add ("g_motor_debug_mailbox.control_last_command_result");
  // Keep the decisive per-task evidence together at the bottom of the list.
  Watch.Add ("g_motor_debug_mailbox.task_selected");
  Watch.Add ("g_motor_debug_mailbox.task_run_state");
  Watch.Add ("g_motor_debug_mailbox.task_fault");
  Watch.Add ("g_motor_debug_mailbox.control_command_count");
  Watch.Add ("g_motor_debug_mailbox.control_last_command_angle_degrees");
  Watch.Add ("g_motor_debug_mailbox.control_last_command_result");
  Watch.Add ("g_motor_debug_mailbox.task_motor_position_valid");
  Watch.Add ("g_motor_debug_mailbox.task_motor_position_degrees");
  Watch.Add ("g_motor_debug_mailbox.motor_position_read_result");
}


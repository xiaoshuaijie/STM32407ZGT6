  "boundaries": [
    {
      "kind": "region",
      "label": "STM32F407 固件控制域",
      "wraps": [
        "runtime",
        "ball_receiver",
        "ball_topic",
        "ball_mailbox",
        "balance_controller",
        "balance_topic",
        "operator_panel",
        "lcd"
      ],
      "pad": 24
    },
    {
      "kind": "security-group",
      "label": "串行外设 / 操作员信任边界",
      "wraps": ["vision_camera", "motor", "terminal"],
      "pad": 24
    }
  ],
  "connections": [
    {
      "id": "vision-to-receiver",

      "variant": "emphasis",
      "labelDy": -52
    },
    {
      "id": "receiver-to-mailbox",
      "from": "ball_receiver",
      "to": "ball_mailbox",
      "label": "校验通过 → latest_",
      "variant": "emphasis",
      "labelDy": -52
    },
    {
      "id": "receiver-to-topic",
      "from": "ball_receiver",
      "to": "ball_topic",
      "label": "Publish(measurement)",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom",
      "via": [[325, 270], [535, 270]],
      "labelAt": [430, 270]
    },
    {
      "id": "mailbox-to-controller",
      "from": "ball_mailbox",
      "to": "balance_controller",
      "label": "WaitForUpdate()",
      "variant": "emphasis",
      "labelDy": -52
    },
    {
      "id": "controller-to-motor",
      "from": "balance_controller",
      "to": "motor",
      "label": "FB / FD 运动命令",
      "variant": "emphasis",
      "labelDy": -52
    },
    {
      "id": "controller-to-state-topic",
      "from": "balance_controller",
      "to": "balance_topic",
      "label": "Publish(snapshot)",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom",
      "via": [[745, 270], [975, 270]],
      "labelAt": [850, 270]
    },
    {
      "id": "operator-to-controller",
      "from": "operator_panel",
      "to": "balance_controller",
      "label": "任务选择 / 启停请求",
      "fromSide": "top",
      "toSide": "bottom",
      "labelAt": [650, 445]
    },
    {
      "id": "controller-to-lcd",
      "from": "balance_controller",
      "to": "lcd",
      "label": "GetStatus() → 渲染",
      "fromSide": "bottom",
      "toSide": "top",
      "via": [[745, 450], [975, 450]],
      "labelAt": [850, 450]
    },
    {
      "id": "mailbox-to-terminal",
      "from": "ball_mailbox",
      "to": "terminal",
      "label": "GetLatest()",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "labelAt": [535, 445]
    },
    {
      "id": "runtime-to-receiver",
      "from": "runtime",
      "to": "ball_receiver",
      "label": "线程 / UART 原语",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "labelAt": [375, 245]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主数据路径",
      "items": [
        "视觉相机经 USART1 输入 AA 55 帧，BallReceiver 校验并按到达顺序解析",
        "有效测量同时发布到 ball_measurement，并覆盖 BallMailbox 的 latest_ 快照",
        "BalanceController 每 20 ms 取最新样本，向 ZDT X42S 发出 USART3 运动命令"
      ]
    },
    {
      "dot": "emerald",
      "title": "所有权与信任边界",
      "items": [
        "STM32F407 固件控制域包含接入、状态、控制器、Topic 与本地 LCD",
        "BalanceController 是仓库中唯一被明确说明可通过 USART3 发电机命令的线程",
        "相机、电机和 USART2 终端位于串行外设 / 操作员边界之外"
      ]
    },
    {
      "dot": "rose",
      "title": "未推断的语义",
      "items": [
        "未发现 Kafka/分区/offset、正式消费者组、重试投递或 exactly-once / at-least-once 证据",
        "未发现 DLQ、失败事件持久化或重放实现；两个 Topic 的 Publish 已确认，订阅注册未确认",
        "LCD 直接读取 BalanceController 状态，USART2 终端直接读取 BallMailbox 最新值"
      ]
    }
  ]
}
